# Configuração local sem segredos reais.
# Copie para .env e ajuste conforme seu ambiente.

DB_DIALECT=mysql
DB_USERNAME=root
DB_PASSWORD=
DB_NAME=auditoria2
DB_CHARSET=utf8mb4
DB_HOST=localhost
DB_PORT=3306

# Diretório local com arquivos SPED/XML.
# Nunca commite dados fiscais reais.
SPEDS_PATH=./speds

# Quantidade mínima de dígitos para normalização de códigos de item.
DIGIT_CODE=10

# Opcional: CNPJ próprio para filtrar SPEDs/XMLs importados.
# Use apenas números ou valor formatado. Exemplo fictício:
CNPJ=00000000000000

WORKER_MAX_WORKERS=3
WORKER_TASK_TIMEOUT=30m
